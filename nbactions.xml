<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings><packaging>jar</packaging></packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.codehaus.mojo:exec-maven-plugin:3.5.0:java</goal>
        </goals>
        <properties>
            <exec.mainClass>bpmn.BpmnToMermaid</exec.mainClass>
            <exec.args>examples/order-fulfillment.bpmn target/order-fulfillment.mmd</exec.args>
            <exec.classpathScope>runtime</exec.classpathScope>
        </properties>
    </action>
</actions>
