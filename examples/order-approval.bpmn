<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="Definitions_1" targetNamespace="urn:example:bpmn"><bpmn:process id="Process_1" name="Order approval" isExecutable="false"><bpmn:startEvent id="Start_1" name="Received"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Task_1" name="Review &amp; approve"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task><bpmn:endEvent id="End_1" name="Done"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Start_1" targetRef="Task_1"></bpmn:sequenceFlow><bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Task_1" targetRef="End_1"></bpmn:sequenceFlow></bpmn:process></bpmn:definitions>