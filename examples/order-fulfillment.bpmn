<?xml version="1.0" encoding="UTF-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="FulfillmentDefinitions" targetNamespace="urn:example:fulfillment"><bpmn:process id="Fulfillment" name="Order fulfillment" isExecutable="false"><bpmn:startEvent id="Received" name="Order received"><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent><bpmn:task id="Review" name="Review order"><bpmn:incoming>F01</bpmn:incoming><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:task><bpmn:exclusiveGateway id="Decision" name="Review result"><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F07</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:task id="Revise" name="Request corrections"><bpmn:incoming>F03</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:task><bpmn:task id="Reject" name="Notify customer of rejection"><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F06</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Rejected" name="Order rejected"><bpmn:incoming>F06</bpmn:incoming></bpmn:endEvent><bpmn:parallelGateway id="Prepare" name="Prepare fulfillment"><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing><bpmn:outgoing>F09</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="Reserve" name="Reserve stock"><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:task><bpmn:task id="Charge" name="Collect payment"><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:task><bpmn:parallelGateway id="Ready" name="Preparation complete"><bpmn:incoming>F10</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:parallelGateway><bpmn:task id="Ship" name="Pack &amp; ship"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:task><bpmn:task id="Notify" name="Send tracking details"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:task><bpmn:endEvent id="Completed" name="Order completed"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F01" name="" sourceRef="Received" targetRef="Review"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F02" name="" sourceRef="Review" targetRef="Decision"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F03" name="Needs correction" sourceRef="Decision" targetRef="Revise"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F04" name="Resubmitted" sourceRef="Revise" targetRef="Review"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F05" name="Rejected" sourceRef="Decision" targetRef="Reject"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F06" name="" sourceRef="Reject" targetRef="Rejected"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F07" name="Approved" sourceRef="Decision" targetRef="Prepare"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F08" name="" sourceRef="Prepare" targetRef="Reserve"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F09" name="" sourceRef="Prepare" targetRef="Charge"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F10" name="Stock reserved" sourceRef="Reserve" targetRef="Ready"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F11" name="Payment collected" sourceRef="Charge" targetRef="Ready"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F12" name="" sourceRef="Ready" targetRef="Ship"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F13" name="" sourceRef="Ship" targetRef="Notify"></bpmn:sequenceFlow><bpmn:sequenceFlow id="F14" name="" sourceRef="Notify" targetRef="Completed"></bpmn:sequenceFlow></bpmn:process></bpmn:definitions>